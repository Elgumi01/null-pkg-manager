{
    "name": "bison",
    "description": "GNU parser generator, compatible with Yacc, used to generate C parsers from grammar specifications; required by Mesa's build for compiling GLSL and other language grammars.",
    "version": "3.8.2",
    "dependencies": [],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o bison-3.8.2.tar.xz https://ftpmirror.gnu.org/bison/bison-3.8.2.tar.xz",
        "tar -xf bison-3.8.2.tar.xz"
    ],
    "build": [
        "cd bison-3.8.2 && ./configure --prefix=\"$PREFIX\" --docdir=\"$PREFIX/share/doc/bison-3.8.2\"",
        "cd bison-3.8.2 && make $MAKEOPTS"
    ],
    "install": [
        "cd bison-3.8.2 && make DESTDIR=\"$DESTDIR\" install"
    ]
}
