{
    "name": "rust-bindgen",
    "description": "A utility that generates Rust bindings from C/C++ headers.",
    "version": "0.72.1",
    "dependencies": [
        "rustc"
    ],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o rust-bindgen-0.72.1.tar.gz https://github.com/rust-lang/rust-bindgen/archive/refs/tags/v0.72.1/rust-bindgen-0.72.1.tar.gz",
        "tar -xf rust-bindgen-0.72.1.tar.gz"
    ],
    "build": [
        "cd rust-bindgen-0.72.1 && cargo build --release --locked"
    ],
    "install": [
        "install -Dm755 rust-bindgen-0.72.1/target/release/bindgen \"$DESTDIR$PREFIX/bin/bindgen\"",
        "mkdir -p \"$DESTDIR$PREFIX/share/bash-completion/completions\" \"$DESTDIR$PREFIX/share/zsh/site-functions\"",
        "rust-bindgen-0.72.1/target/release/bindgen --generate-shell-completions bash > \"$DESTDIR$PREFIX/share/bash-completion/completions/bindgen\"",
        "rust-bindgen-0.72.1/target/release/bindgen --generate-shell-completions zsh > \"$DESTDIR$PREFIX/share/zsh/site-functions/_bindgen\""
    ]
}
