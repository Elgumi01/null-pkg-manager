{
  "name": "libfontenc",
  "description": "X11 font encoding library, providing routines for mapping between font glyph encodings, used internally by libXfont2 and the X font system.",
  "version": "1.1.9",
  "dependencies": [
    "xorgproto",
    "util-macros",
    "zlib"
  ],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o libfontenc-1.1.9.tar.xz https://www.x.org/pub/individual/lib/libfontenc-1.1.9.tar.xz",
    "tar -xf libfontenc-1.1.9.tar.xz"
  ],
  "build": [
    "cd libfontenc-1.1.9 && ./configure $XORG_CONFIG --docdir=\"$XORG_PREFIX/share/doc/libfontenc-1.1.9\"",
    "cd libfontenc-1.1.9 && make $MAKEOPTS"
  ],
  "install": [
    "cd libfontenc-1.1.9 && make DESTDIR=\"$DESTDIR\" install"
  ]
}
