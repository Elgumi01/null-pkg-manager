{
    "name": "libxcursor",
    "description": "X Cursor management library, providing loading and handling of cursor themes and cursor image files used by desktop environments.",
    "version": "1.2.3",
    "dependencies": [
        "libxrender",
        "libxfixes",
        "libx11",
        "xorgproto"
    ],
    "download": [
        "curl -LO https://www.x.org/pub/individual/lib/libXcursor-1.2.3.tar.xz",
        "tar -xf libXcursor-1.2.3.tar.xz"
    ],
    "build": [
        "cd libXcursor-1.2.3 && ./configure $XORG_CONFIG --docdir=$XORG_PREFIX/share/doc/libXcursor-1.2.3",
        "cd libXcursor-1.2.3 && make $MAKEOPTS"
    ],
    "install": [
        "cd libXcursor-1.2.3 && make install"
    ]
}
