{
  "name": "libxvmc",
  "description": "X-Video Motion Compensation Library, extending libXv with hardware-accelerated video decoding support.",
  "version": "1.0.15",
  "dependencies": [
    "libxv",
    "libxext",
    "libx11",
    "xorgproto"
  ],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o libXvMC-1.0.15.tar.xz https://www.x.org/pub/individual/lib/libXvMC-1.0.15.tar.xz",
    "tar -xf libXvMC-1.0.15.tar.xz"
  ],
  "build": [
    "cd libXvMC-1.0.15 && ./configure $XORG_CONFIG --docdir=\"$XORG_PREFIX/share/doc/libXvMC-1.0.15\"",
    "cd libXvMC-1.0.15 && make $MAKEOPTS"
  ],
  "install": [
    "cd libXvMC-1.0.15 && make DESTDIR=\"$DESTDIR\" install"
  ]
}
