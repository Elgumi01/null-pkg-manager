{
  "name": "libx11",
  "description": "Xlib, the core X11 client library implementing the low-level protocol used by nearly all X Window applications.",
  "version": "1.8.13",
  "dependencies": [
    "xtrans",
    "xorgproto",
    "libxcb"
  ],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o libX11-1.8.13.tar.xz https://www.x.org/pub/individual/lib/libX11-1.8.13.tar.xz",
    "tar -xf libX11-1.8.13.tar.xz"
  ],
  "build": [
    "cd libX11-1.8.13 && ./configure $XORG_CONFIG --docdir=\"$XORG_PREFIX/share/doc/libX11-1.8.13\"",
    "cd libX11-1.8.13 && make $MAKEOPTS"
  ],
  "install": [
    "cd libX11-1.8.13 && make DESTDIR=\"$DESTDIR\" install"
  ]
}
