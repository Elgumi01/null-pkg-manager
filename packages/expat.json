{
    "name": "expat",
    "description": "Stream-oriented XML parser library written in C.",
    "version": "2.8.2",
    "dependencies": [],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o expat-2.8.2.tar.xz https://github.com/libexpat/libexpat/releases/download/R_2_8_2/expat-2.8.2.tar.xz",
        "tar -xf expat-2.8.2.tar.xz"
    ],
    "build": [
        "cd expat-2.8.2 && ./configure $XORG_CONFIG",
        "cd expat-2.8.2 && make $MAKEOPTS"
    ],
    "install": [
        "cd expat-2.8.2 && make DESTDIR=\"$DESTDIR\" install"
    ]
}
