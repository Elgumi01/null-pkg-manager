{
    "name": "nghttp2",
    "description": "Implementation of HTTP/2 and its HPACK header compression algorithm.",
    "version": "1.68.0",
    "dependencies": [],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o nghttp2-1.68.0.tar.xz https://github.com/nghttp2/nghttp2/releases/download/v1.68.0/nghttp2-1.68.0.tar.xz",
        "tar -xf nghttp2-1.68.0.tar.xz"
    ],
    "build": [
        "cd nghttp2-1.68.0 && ./configure --prefix=\"$PREFIX\" --disable-static --enable-lib-only --docdir=\"$PREFIX/share/doc/nghttp2-1.68.0\"",
        "cd nghttp2-1.68.0 && make $MAKEOPTS"
    ],
    "install": [
        "cd nghttp2-1.68.0 && make DESTDIR=\"$DESTDIR\" install"
    ]
}
