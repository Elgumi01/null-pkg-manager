{
    "name": "gcc",
    "description": "GNU Compiler Collection, providing the GCC (C) and G++ (C++) compilers along with supporting runtime libraries such as libgcc, libstdc++, and libatomic.",
    "version": "15.2.0",
    "dependencies": [
        "binutils",
        "zlib"
    ],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o gcc-15.2.0.tar.xz https://ftpmirror.gnu.org/gcc/gcc-15.2.0/gcc-15.2.0.tar.xz",
        "tar -xf gcc-15.2.0.tar.xz"
    ],
    "build": [
        "cd gcc-15.2.0 && mkdir -v build",
        "cd gcc-15.2.0/build && ../configure --prefix=\"$PREFIX\" LD=ld --enable-languages=c,c++ --enable-default-pie --enable-default-ssp --enable-host-pie --disable-multilib --disable-bootstrap --disable-fixincludes --with-system-zlib",
        "cd gcc-15.2.0/build && make $MAKEOPTS"
    ],
    "install": [
        "cd gcc-15.2.0/build && make DESTDIR=\"$DESTDIR\" install"
    ]
}
