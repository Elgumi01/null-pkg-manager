{
    "name": "spirv-headers",
    "description": "Headers that allow applications to use the SPIR-V language and instruction set with Vulkan.",
    "version": "1.4.341.0",
    "dependencies": [
        "cmake",
        "ninja"
    ],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o SPIRV-Headers-vulkan-sdk-1.4.341.0.tar.gz https://github.com/KhronosGroup/SPIRV-Headers/archive/vulkan-sdk-1.4.341.0/SPIRV-Headers-vulkan-sdk-1.4.341.0.tar.gz",
        "tar -xf SPIRV-Headers-vulkan-sdk-1.4.341.0.tar.gz"
    ],
    "build": [
        "cmake -S SPIRV-Headers-vulkan-sdk-1.4.341.0 -B SPIRV-Headers-vulkan-sdk-1.4.341.0/build -G Ninja -DCMAKE_INSTALL_PREFIX=\"$PREFIX\"",
        "ninja -C SPIRV-Headers-vulkan-sdk-1.4.341.0/build $MAKEOPTS"
    ],
    "install": [
        "DESTDIR=\"$DESTDIR\" ninja -C SPIRV-Headers-vulkan-sdk-1.4.341.0/build install"
    ]
}
