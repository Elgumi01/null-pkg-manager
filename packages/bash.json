{
    "name": "bash",
    "description": "GNU Bourne-Again SHell, the standard interactive command interpreter and scripting shell used as /bin/sh on most Linux systems.",
    "version": "5.3",
    "dependencies": [
        "readline",
        "ncurses"
    ],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o bash-5.3.tar.gz https://ftp.gnu.org/gnu/bash/bash-5.3.tar.gz",
        "tar -xf bash-5.3.tar.gz"
    ],
    "build": [
        "cd bash-5.3 && ./configure --prefix=\"$PREFIX\" --without-bash-malloc --with-installed-readline",
        "cd bash-5.3 && make $MAKEOPTS"
    ],
    "install": [
        "cd bash-5.3 && make DESTDIR=\"$DESTDIR\" install"
    ]
}
