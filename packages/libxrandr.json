{
  "name": "libxrandr",
  "description": "X Resize, Rotate and Reflection extension library, providing client-side support for dynamic display configuration changes.",
  "version": "1.5.5",
  "dependencies": [
    "libxext",
    "libxrender",
    "libx11",
    "xorgproto"
  ],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o libXrandr-1.5.5.tar.xz https://www.x.org/pub/individual/lib/libXrandr-1.5.5.tar.xz",
    "tar -xf libXrandr-1.5.5.tar.xz"
  ],
  "build": [
    "cd libXrandr-1.5.5 && ./configure $XORG_CONFIG --docdir=\"$XORG_PREFIX/share/doc/libXrandr-1.5.5\"",
    "cd libXrandr-1.5.5 && make $MAKEOPTS"
  ],
  "install": [
    "cd libXrandr-1.5.5 && make DESTDIR=\"$DESTDIR\" install"
  ]
}
