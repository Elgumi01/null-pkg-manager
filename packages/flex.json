{
    "name": "flex",
    "description": "Fast lexical analyzer generator, producing programs that recognize lexical patterns in text; used alongside Bison by Mesa's build to generate GLSL and shader language lexers/parsers.",
    "version": "2.6.4",
    "dependencies": [],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o flex-2.6.4.tar.gz https://github.com/westes/flex/releases/download/v2.6.4/flex-2.6.4.tar.gz",
        "tar -xf flex-2.6.4.tar.gz"
    ],
    "build": [
        "cd flex-2.6.4 && ./configure --prefix=\"$PREFIX\" --disable-static --docdir=\"$PREFIX/share/doc/flex-2.6.4\"",
        "cd flex-2.6.4 && make $MAKEOPTS"
    ],
    "install": [
        "cd flex-2.6.4 && make DESTDIR=\"$DESTDIR\" install",
        "ln -sv flex \"$DESTDIR$PREFIX/bin/lex\"",
        "ln -sv flex.1 \"$DESTDIR$PREFIX/share/man/man1/lex.1\""
    ]
}
