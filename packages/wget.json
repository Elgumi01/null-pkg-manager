{
    "name": "wget",
    "description": "Utility for non-interactive downloading of files from the Web via HTTP, HTTPS, and FTP protocols, designed for background or unattended operations.",
    "version": "1.25.0",
    "dependencies": [
        "openssl"
    ],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o wget-1.25.0.tar.gz https://ftp.gnu.org/gnu/wget/wget-1.25.0.tar.gz",
        "tar -xf wget-1.25.0.tar.gz"
    ],
    "build": [
        "cd wget-1.25.0 && ./configure --prefix=\"$PREFIX\" --sysconfdir=/etc --with-ssl=openssl",
        "cd wget-1.25.0 && make $MAKEOPTS"
    ],
    "install": [
        "cd wget-1.25.0 && make DESTDIR=\"$DESTDIR\" install"
    ]
}
