{
  "name": "openssh",
  "description": "Secure shell client and server",
  "version": "10.2p1",
  "dependencies": [],
  "download": [
    "wget https://cdn.openbsd.org/pub/OpenBSD/OpenSSH/portable/openssh-10.2p1.tar.gz",
    "tar -xf openssh-10.2p1.tar.gz"
  ],
  "prepare": [
    "groupadd -g 50 sshd",
    "useradd -c 'sshd PrivSep' -d /var/lib/sshd -g sshd -s /bin/false -u 50 sshd"
  ],
  "build": [
    "cd openssh-10.2p1 && ./configure --prefix=$PREFIX --sysconfdir=/etc/ssh --with-privsep-path=/var/lib/sshd --with-pid-dir=/run",
    "cd openssh-10.2p1 && make $MAKEOPTS"
  ],
  "install": [
    "cd openssh-10.2p1 && make install"
  ]
}
