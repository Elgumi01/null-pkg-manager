{
  "name": "libxinerama",
  "description": "Xinerama extension library, providing support for multi-monitor setups treated as a single logical display.",
  "version": "1.1.6",
  "dependencies": [
    "libxext",
    "libx11",
    "xorgproto"
  ],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o libXinerama-1.1.6.tar.xz https://www.x.org/pub/individual/lib/libXinerama-1.1.6.tar.xz",
    "tar -xf libXinerama-1.1.6.tar.xz"
  ],
  "build": [
    "cd libXinerama-1.1.6 && ./configure $XORG_CONFIG --docdir=\"$XORG_PREFIX/share/doc/libXinerama-1.1.6\"",
    "cd libXinerama-1.1.6 && make $MAKEOPTS"
  ],
  "install": [
    "cd libXinerama-1.1.6 && make DESTDIR=\"$DESTDIR\" install"
  ]
}
