{
    "name": "xtrans",
    "description": "X Transport library, providing a common network transport layer interface used internally by other X11 libraries and the X server.",
    "version": "1.6.0",
    "dependencies": [
        "xorgproto"
    ],
    "download": [
        "curl -LO https://www.x.org/pub/individual/lib/xtrans-1.6.0.tar.xz",
        "tar -xf xtrans-1.6.0.tar.xz"
    ],
    "build": [
        "cd xtrans-1.6.0 && ./configure --prefix=$XORG_PREFIX --docdir=$XORG_PREFIX/share/doc/xtrans-1.6.0",
        "cd xtrans-1.6.0 && make $MAKEOPTS"
    ],
    "install": [
        "cd xtrans-1.6.0 && make install"
    ]
}
