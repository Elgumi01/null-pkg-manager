{
    "name": "gettext",
    "description": "Internationalization and localization utilities that allow programs to be compiled with NLS (Native Language Support), enabling them to output messages in the user's native language.",
    "version": "1.0",
    "dependencies": [],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o gettext-1.0.tar.xz https://ftpmirror.gnu.org/gettext/gettext-1.0.tar.xz",
        "tar -xf gettext-1.0.tar.xz"
    ],
    "build": [
        "cd gettext-1.0 && ./configure --prefix=\"$PREFIX\" --disable-static --docdir=\"$PREFIX/share/doc/gettext-1.0\"",
        "cd gettext-1.0 && make $MAKEOPTS"
    ],
    "install": [
        "cd gettext-1.0 && make DESTDIR=\"$DESTDIR\" install"
    ]
}
