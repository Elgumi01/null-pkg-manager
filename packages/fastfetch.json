{
    "name": "fastfetch",
    "description": "A maintained, feature-rich, and performance-oriented system information tool in the style of neofetch, displaying hardware and OS details in the terminal.",
    "version": "2.36.0",
    "dependencies": [],
    "download": [
        "git clone --depth 1 --branch 2.36.0 https://github.com/fastfetch-cli/fastfetch"
    ],
    "build": [
        "cmake -S fastfetch -B fastfetch/build -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" -DCMAKE_BUILD_TYPE=Release",
        "cmake --build fastfetch/build -- $MAKEOPTS"
    ],
    "install": [
        "DESTDIR=\"$DESTDIR\" cmake --install fastfetch/build"
    ]
}
