{
    "name": "automake",
    "description": "GNU Automake, a tool for generating Makefile.in files compliant with the GNU Coding Standards, driven by Autoconf; required by the GNU Autotools build system.",
    "version": "1.18.1",
    "dependencies": [
        "autoconf"
    ],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o automake-1.18.1.tar.xz https://ftpmirror.gnu.org/automake/automake-1.18.1.tar.xz",
        "tar -xf automake-1.18.1.tar.xz"
    ],
    "build": [
        "cd automake-1.18.1 && ./configure --prefix=\"$PREFIX\" --docdir=\"$PREFIX/share/doc/automake-1.18.1\"",
        "cd automake-1.18.1 && make $MAKEOPTS"
    ],
    "install": [
        "cd automake-1.18.1 && make DESTDIR=\"$DESTDIR\" install"
    ]
}
