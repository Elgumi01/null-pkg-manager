{
    "name": "fontconfig",
    "description": "Library and utilities for configuring and customizing font access.",
    "version": "2.18.2",
    "dependencies": [
        "freetype",
        "expat",
        "gperf"
    ],
    "download": [
        "curl -LO https://gitlab.freedesktop.org/api/v4/projects/890/packages/generic/fontconfig/2.18.2/fontconfig-2.18.2.tar.xz",
        "tar -xf fontconfig-2.18.2.tar.xz"
    ],
    "build": [
        "cd fontconfig-2.18.2 && ./configure $XORG_CONFIG --disable-docs",
        "cd fontconfig-2.18.2 && make $MAKEOPTS"
    ],
    "install": [
        "cd fontconfig-2.18.2 && make install"
    ]
}
