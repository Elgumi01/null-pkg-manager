{
    "name": "libxi",
    "description": "X Input Extension Library, providing client-side bindings for advanced input devices such as tablets, touchscreens, and multi-pointer setups.",
    "version": "1.8.2",
    "dependencies": [
        "libxext",
        "libxfixes",
        "libx11",
        "xorgproto"
    ],
    "download": [
        "curl -LO https://www.x.org/pub/individual/lib/libXi-1.8.2.tar.xz",
        "tar -xf libXi-1.8.2.tar.xz"
    ],
    "build": [
        "cd libXi-1.8.2 && ./configure $XORG_CONFIG --docdir=$XORG_PREFIX/share/doc/libXi-1.8.2",
        "cd libXi-1.8.2 && make $MAKEOPTS"
    ],
    "install": [
        "cd libXi-1.8.2 && make install"
    ]
}
