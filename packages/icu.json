{
    "name": "icu",
    "description": "International Components for Unicode libraries.",
    "version": "78.2",
    "dependencies": [],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o icu4c-78.2-sources.tgz https://github.com/unicode-org/icu/releases/download/release-78.2/icu4c-78.2-sources.tgz",
        "tar -xf icu4c-78.2-sources.tgz"
    ],
    "build": [
        "cd icu/source && ./configure --prefix=\"$PREFIX\"",
        "cd icu/source && make $MAKEOPTS"
    ],
    "install": [
        "cd icu/source && make DESTDIR=\"$DESTDIR\" install"
    ]
}
