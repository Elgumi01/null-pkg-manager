{
  "name": "icu",
  "description": "International Components for Unicode libraries.",
  "version": "78.2",
  "dependencies": [],
  "download": [
    "curl -LO https://github.com/unicode-org/icu/releases/download/release-78.2/icu4c-78.2-sources.tgz",
    "tar -xf icu4c-78.2-sources.tgz"
  ],
  "build": [
    "cd icu/source && ./configure --prefix=/usr && make"
  ],
  "install": [
    "cd icu/source && DESTDIR=$DESTDIR make install"
  ]
}
