{
    "name": "libxfont2",
    "description": "X font library, providing font access routines shared between the X server and font-related utilities.",
    "version": "2.0.7",
    "dependencies": [
        "libfontenc",
        "libxfixes",
        "xorgproto",
        "freetype"
    ],
    "download": [
        "curl -LO https://www.x.org/pub/individual/lib/libXfont2-2.0.7.tar.xz",
        "tar -xf libXfont2-2.0.7.tar.xz"
    ],
    "build": [
        "cd libXfont2-2.0.7 && ./configure $XORG_CONFIG --docdir=$XORG_PREFIX/share/doc/libXfont2-2.0.7 --disable-devel-docs",
        "cd libXfont2-2.0.7 && make $MAKEOPTS"
    ],
    "install": [
        "cd libXfont2-2.0.7 && make install"
    ]
}
