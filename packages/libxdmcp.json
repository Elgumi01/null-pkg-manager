{
    "name": "libxdmcp",
    "description": "X Display Manager Control Protocol library.",
    "version": "1.1.5",
    "dependencies": [
        "xorgproto"
    ],
    "download": [
        "curl -LO https://www.x.org/pub/individual/lib/libXdmcp-1.1.5.tar.xz",
        "tar -xf libXdmcp-1.1.5.tar.xz"
    ],
    "build": [
        "cd libXdmcp-1.1.5 && ./configure $XORG_CONFIG --docdir='${datadir}'/doc/libXdmcp-1.1.5",
        "cd libXdmcp-1.1.5 && make $MAKEOPTS"
    ],
    "install": [
        "cd libXdmcp-1.1.5 && make install"
    ]
}
