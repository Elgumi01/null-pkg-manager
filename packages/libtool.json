{
  "name": "libtool",
  "description": "GNU Libtool, a generic library support script that provides a consistent, portable interface for building and using shared libraries across Unix-like systems.",
  "version": "2.5.4",
  "dependencies": [
    "automake"
  ],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o libtool-2.5.4.tar.xz https://ftpmirror.gnu.org/libtool/libtool-2.5.4.tar.xz",
    "tar -xf libtool-2.5.4.tar.xz"
  ],
  "build": [
    "cd libtool-2.5.4 && ./configure --prefix=\"$PREFIX\"",
    "cd libtool-2.5.4 && make $MAKEOPTS"
  ],
  "install": [
    "cd libtool-2.5.4 && make DESTDIR=\"$DESTDIR\" install"
  ]
}
