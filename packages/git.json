{
    "name": "git",
    "description": "Distributed version control system designed to handle everything from small to very large projects with speed and efficiency, providing full revision history and branching independent of network access or a central server.",
    "version": "2.51.1",
    "dependencies": [
        "openssl",
        "zlib",
        "perl",
        "gettext"
    ],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o git-2.51.1.tar.xz https://www.kernel.org/pub/software/scm/git/git-2.51.1.tar.xz",
        "tar -xf git-2.51.1.tar.xz"
    ],
    "build": [
        "cd git-2.51.1 && ./configure --prefix=\"$PREFIX\" --with-gitconfig=/etc/gitconfig",
        "cd git-2.51.1 && make $MAKEOPTS"
    ],
    "install": [
        "cd git-2.51.1 && make DESTDIR=\"$DESTDIR\" install"
    ]
}
