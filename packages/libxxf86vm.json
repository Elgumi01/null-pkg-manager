{
    "name": "libxxf86vm",
    "description": "Client library for the XFree86-VidMode X extension, allowing applications to query and switch video modes and gamma settings.",
    "version": "1.1.7",
    "dependencies": [
        "libxext",
        "libx11",
        "xorgproto"
    ],
    "download": [
        "curl -LO https://www.x.org/pub/individual/lib/libXxf86vm-1.1.7.tar.xz",
        "tar -xf libXxf86vm-1.1.7.tar.xz"
    ],
    "build": [
        "cd libXxf86vm-1.1.7 && ./configure $XORG_CONFIG --docdir=$XORG_PREFIX/share/doc/libXxf86vm-1.1.7",
        "cd libXxf86vm-1.1.7 && make $MAKEOPTS"
    ],
    "install": [
        "cd libXxf86vm-1.1.7 && make install"
    ]
}
