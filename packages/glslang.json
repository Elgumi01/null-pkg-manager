{
    "name": "glslang",
    "description": "Khronos-reference front end for GLSL/ESSL, partial front end for HLSL, and a SPIR-V generator.",
    "version": "16.2.0",
    "dependencies": [
        "spirv-tools",
        "ninja",
        "cmake"
    ],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o glslang-16.2.0.tar.gz https://github.com/KhronosGroup/glslang/archive/16.2.0/glslang-16.2.0.tar.gz",
        "tar -xf glslang-16.2.0.tar.gz"
    ],
    "build": [
        "cd glslang-16.2.0 && cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=\"$PREFIX\" -DCMAKE_BUILD_TYPE=Release -DALLOW_EXTERNAL_SPIRV_TOOLS=ON -DBUILD_SHARED_LIBS=ON -DGLSLANG_TESTS=OFF",
        "cmake --build glslang-16.2.0/build -- $MAKEOPTS"
    ],
    "install": [
        "DESTDIR=\"$DESTDIR\" cmake --install glslang-16.2.0/build"
    ]
}
