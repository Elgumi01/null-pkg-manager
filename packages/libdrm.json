{
  "name": "libdrm",
  "description": "Userspace library for accessing the Direct Rendering Manager (DRM) interface.",
  "version": "2.4.134",
  "dependencies": [
    "xorg-libraries",
    "meson",
    "ninja",
    "eudev"
  ],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o libdrm-2.4.134.tar.xz https://dri.freedesktop.org/libdrm/libdrm-2.4.134.tar.xz",
    "tar -xf libdrm-2.4.134.tar.xz"
  ],
  "build": [
    "meson setup --prefix=\"$XORG_PREFIX\" --buildtype=release -Dudev=true -Dvalgrind=disabled libdrm-2.4.134/build libdrm-2.4.134",
    "ninja -C libdrm-2.4.134/build $MAKEOPTS"
  ],
  "install": [
    "DESTDIR=\"$DESTDIR\" ninja -C libdrm-2.4.134/build install"
  ]
}
