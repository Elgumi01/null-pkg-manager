{
    "name": "libxcb",
    "description": "X C Binding library, providing an interface to the X Window System protocol.",
    "version": "1.17.0",
    "dependencies": [
        "libxau",
        "xcb-proto",
        "libxdmcp"
    ],
    "download": [
        "curl -LO https://xorg.freedesktop.org/archive/individual/lib/libxcb-1.17.0.tar.xz",
        "tar -xf libxcb-1.17.0.tar.xz"
    ],
    "build": [
        "cd libxcb-1.17.0 && ./configure $XORG_CONFIG --without-doxygen --docdir=$XORG_PREFIX/share/doc/libxcb-1.17.0",
        "cd libxcb-1.17.0 && LC_ALL=en_US.UTF-8 make $MAKEOPTS"
    ],
    "install": [
        "cd libxcb-1.17.0 && make install"
    ]
}
