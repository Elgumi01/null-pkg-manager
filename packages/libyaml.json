{
  "name": "libyaml",
  "description": "A C library for parsing and emitting YAML code.",
  "version": "0.2.5",
  "dependencies": [],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o yaml-0.2.5.tar.gz https://github.com/yaml/libyaml/releases/download/0.2.5/yaml-0.2.5.tar.gz",
    "tar -xf yaml-0.2.5.tar.gz"
  ],
  "build": [
    "cd yaml-0.2.5 && ./configure --prefix=\"$PREFIX\" --disable-static",
    "cd yaml-0.2.5 && make $MAKEOPTS"
  ],
  "install": [
    "cd yaml-0.2.5 && make DESTDIR=\"$DESTDIR\" install"
  ]
}
