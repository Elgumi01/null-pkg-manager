{
    "name": "m4",
    "description": "GNU M4 macro processor, copying input to output while expanding macros; used as a core dependency of the GNU Autotools build system (Autoconf, Automake, Libtool).",
    "version": "1.4.21",
    "dependencies": [],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o m4-1.4.21.tar.xz https://ftpmirror.gnu.org/m4/m4-1.4.21.tar.xz",
        "tar -xf m4-1.4.21.tar.xz"
    ],
    "build": [
        "cd m4-1.4.21 && ./configure --prefix=\"$PREFIX\"",
        "cd m4-1.4.21 && make $MAKEOPTS"
    ],
    "install": [
        "cd m4-1.4.21 && make DESTDIR=\"$DESTDIR\" install"
    ]
}
