{
    "name": "kmod",
    "description": "Set of tools (insmod, rmmod, modprobe, depmod, lsmod, modinfo) and libkmod library for loading, unloading, listing, and inspecting Linux kernel modules.",
    "version": "34",
    "dependencies": [
        "meson",
        "ninja",
        "zstd",
        "scdoc"
    ],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o kmod-34.tar.gz https://github.com/kmod-project/kmod/archive/refs/tags/v34.tar.gz",
        "tar -xf kmod-34.tar.gz"
    ],
    "build": [
        "meson setup kmod-34/build kmod-34 --prefix=\"$PREFIX\" --buildtype=release --wrap-mode=nodownload",
        "ninja -C kmod-34/build $MAKEOPTS"
    ],
    "install": [
        "DESTDIR=\"$DESTDIR\" ninja -C kmod-34/build install"
    ]
}
