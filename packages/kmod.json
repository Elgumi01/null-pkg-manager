{
    "name": "kmod",
    "description": "Set of tools (insmod, rmmod, modprobe, depmod, lsmod, modinfo) and libkmod library for loading, unloading, listing, and inspecting Linux kernel modules.",
    "version": "34",
    "dependencies": [
        "meson",
        "ninja",
        "zstd",
        "scdoc"
    ],
    "download": [
        "curl -LO https://github.com/kmod-project/kmod/archive/refs/tags/v34.tar.gz",
        "tar -xf v34.tar.gz"
    ],
    "build": [
        "meson setup --prefix=/usr --buildtype=release kmod-34/build kmod-34",
        "ninja -C kmod-34/build $MAKEOPTS"
    ],
    "install": [
        "DESTDIR=$DESTDIR ninja -C kmod-34/build install"
    ]
}
