{
    "name": "wayland",
    "description": "Core Wayland library implementing the communication protocol between a display server and its clients, providing the wayland-scanner tool used to generate protocol bindings for Wayland-Protocols and Mesa.",
    "version": "1.25.0",
    "dependencies": [
        "expat",
        "libffi",
        "libxml2"
    ],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o wayland-1.25.0.tar.xz https://gitlab.freedesktop.org/wayland/wayland/-/releases/1.25.0/downloads/wayland-1.25.0.tar.xz",
        "tar -xf wayland-1.25.0.tar.xz"
    ],
    "build": [
        "meson setup wayland-1.25.0/build wayland-1.25.0 --prefix=\"$PREFIX\" --buildtype=release -Ddocumentation=false --wrap-mode=nodownload",
        "ninja -C wayland-1.25.0/build $MAKEOPTS"
    ],
    "install": [
        "DESTDIR=\"$DESTDIR\" ninja -C wayland-1.25.0/build install"
    ]
}
