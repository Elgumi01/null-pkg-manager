{
  "name": "libxext",
  "description": "Misc X Extension Library, providing client-side bindings for common X server extensions used by many X applications.",
  "version": "1.3.7",
  "dependencies": [
    "libx11",
    "xorgproto"
  ],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o libXext-1.3.7.tar.xz https://www.x.org/pub/individual/lib/libXext-1.3.7.tar.xz",
    "tar -xf libXext-1.3.7.tar.xz"
  ],
  "build": [
    "cd libXext-1.3.7 && ./configure $XORG_CONFIG --docdir=\"$XORG_PREFIX/share/doc/libXext-1.3.7\"",
    "cd libXext-1.3.7 && make $MAKEOPTS"
  ],
  "install": [
    "cd libXext-1.3.7 && make DESTDIR=\"$DESTDIR\" install"
  ]
}
