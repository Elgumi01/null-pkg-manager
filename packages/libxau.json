{
  "name": "libxau",
  "description": "X11 Authorization Protocol library, used for restricting client access to the display.",
  "version": "1.0.12",
  "dependencies": [
    "xorgproto"
  ],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o libXau-1.0.12.tar.xz https://www.x.org/pub/individual/lib/libXau-1.0.12.tar.xz",
    "tar -xf libXau-1.0.12.tar.xz"
  ],
  "build": [
    "cd libXau-1.0.12 && ./configure $XORG_CONFIG",
    "cd libXau-1.0.12 && make $MAKEOPTS"
  ],
  "install": [
    "cd libXau-1.0.12 && make DESTDIR=\"$DESTDIR\" install"
  ]
}
