{
    "name": "libxmu",
    "description": "X interface library for miscellaneous utilities not part of the core Xlib standard, used internally by libXaw and other toolkit libraries.",
    "version": "1.3.1",
    "dependencies": [
        "libxt",
        "libxext",
        "libx11",
        "xorgproto"
    ],
    "download": [
        "curl -LO https://www.x.org/pub/individual/lib/libXmu-1.3.1.tar.xz",
        "tar -xf libXmu-1.3.1.tar.xz"
    ],
    "build": [
        "cd libXmu-1.3.1 && ./configure $XORG_CONFIG --docdir=$XORG_PREFIX/share/doc/libXmu-1.3.1",
        "cd libXmu-1.3.1 && make $MAKEOPTS"
    ],
    "install": [
        "cd libXmu-1.3.1 && make install"
    ]
}
