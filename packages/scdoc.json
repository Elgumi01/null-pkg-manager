{
    "name": "scdoc",
    "description": "Small man page generator for POSIX systems.",
    "version": "1.11.3",
    "dependencies": [],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o scdoc-1.11.3.tar.gz https://git.sr.ht/~sircmpwn/scdoc/archive/1.11.3.tar.gz",
        "tar -xf scdoc-1.11.3.tar.gz"
    ],
    "build": [
        "cd scdoc-1.11.3 && make $MAKEOPTS"
    ],
    "install": [
        "cd scdoc-1.11.3 && make DESTDIR=\"$DESTDIR\" PREFIX=\"$PREFIX\" install"
    ]
}
