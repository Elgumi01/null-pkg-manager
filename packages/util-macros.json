{
    "name": "util-macros",
    "description": "Provides the m4 autoconf macros used by all Xorg packages during their build configuration step.",
    "version": "1.20.2",
    "dependencies": [],
    "download": [
        "curl -LO https://www.x.org/pub/individual/util/util-macros-1.20.2.tar.xz",
        "tar -xf util-macros-1.20.2.tar.xz"
    ],
    "build": [
        "cd util-macros-1.20.2 && ./configure $XORG_CONFIG"
    ],
    "install": [
        "cd util-macros-1.20.2 && make install"
    ]
}
