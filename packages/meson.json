{
    "name": "meson",
    "description": "High-performance build system that generates Ninja (or other) build files, used to configure and build many modern C/C++ and Xorg/Mesa projects.",
    "version": "1.11.1",
    "dependencies": [
        "python",
        "setuptools",
        "ninja"
    ],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o meson-1.11.1.tar.gz https://github.com/mesonbuild/meson/releases/download/1.11.1/meson-1.11.1.tar.gz",
        "tar -xf meson-1.11.1.tar.gz"
    ],
    "build": [
        "cd meson-1.11.1 && python3 setup.py build"
    ],
    "install": [
        "cd meson-1.11.1 && python3 -m pip install . --no-deps --root=\"$DESTDIR\" --prefix=\"$PREFIX\" --break-system-packages"
    ]
}
