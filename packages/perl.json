{
    "name": "perl",
    "description": "Practical Extraction and Report Language interpreter, a general-purpose programming language widely used for text processing, system administration, and as a build-time dependency for many other packages.",
    "version": "5.42.0",
    "dependencies": [],
    "download": [
        "curl -fL --retry 3 --retry-delay 2 -o perl-5.42.0.tar.xz https://www.cpan.org/src/5.0/perl-5.42.0.tar.xz",
        "tar -xf perl-5.42.0.tar.xz"
    ],
    "build": [
        "cd perl-5.42.0 && sh Configure -des -Dprefix=\"$PREFIX\" -Dvendorprefix=\"$PREFIX\" -Dprivlib=\"$PREFIX/lib/perl5/5.42/core_perl\" -Darchlib=\"$PREFIX/lib/perl5/5.42/core_perl\" -Dsitelib=\"$PREFIX/lib/perl5/5.42/site_perl\" -Dsitearch=\"$PREFIX/lib/perl5/5.42/site_perl\" -Dvendorlib=\"$PREFIX/lib/perl5/5.42/vendor_perl\" -Dvendorarch=\"$PREFIX/lib/perl5/5.42/vendor_perl\" -Dman1dir=\"$PREFIX/share/man/man1\" -Dman3dir=\"$PREFIX/share/man/man3\" -Dpager=\"$PREFIX/bin/less -isR\" -Duseshrplib -Dusethreads",
        "cd perl-5.42.0 && make $MAKEOPTS"
    ],
    "install": [
        "cd perl-5.42.0 && make DESTDIR=\"$DESTDIR\" install"
    ]
}
