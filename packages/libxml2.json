{
  "name": "libxml2",
  "description": "An XML parsing library and utilities.",
  "version": "2.15.1",
  "dependencies": [
    "icu"
  ],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o libxml2-2.15.1.tar.xz https://download.gnome.org/sources/libxml2/2.15/libxml2-2.15.1.tar.xz",
    "tar -xf libxml2-2.15.1.tar.xz"
  ],
  "build": [
    "cd libxml2-2.15.1 && sed -i \"/'git'/,+3d\" meson.build",
    "meson setup --prefix=\"$PREFIX\" --buildtype=release -D icu=enabled libxml2-2.15.1/build libxml2-2.15.1",
    "ninja -C libxml2-2.15.1/build $MAKEOPTS"
  ],
  "install": [
    "DESTDIR=\"$DESTDIR\" ninja -C libxml2-2.15.1/build install",
    "sed -i 's/--static/--shared/' \"$DESTDIR$PREFIX/bin/xml2-config\""
  ]
}
