{
    "name": "freetype",
    "description": "Font rendering library used to render fonts into bitmaps or pixmaps.",
    "version": "2.14.1",
    "dependencies": [],
    "download": [
        "curl -LO https://sourceforge.net/projects/freetype/files/freetype2/2.14.1/freetype-2.14.1.tar.xz/download",
        "mv download freetype-2.14.1.tar.xz",
        "tar -xf freetype-2.14.1.tar.xz"
    ],
    "build": [
        "cd freetype-2.14.1 && ./configure $XORG_CONFIG",
        "cd freetype-2.14.1 && make $MAKEOPTS"
    ],
    "install": [
        "cd freetype-2.14.1 && make install"
    ]
}
