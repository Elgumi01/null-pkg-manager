{
  "name": "libarchive",
  "description": "Library providing a single interface for reading and writing various compression and archive formats.",
  "version": "3.8.5",
  "dependencies": [],
  "download": [
    "wget https://github.com/libarchive/libarchive/releases/download/v3.8.5/libarchive-3.8.5.tar.xz",
    "tar -xf libarchive-3.8.5.tar.xz"
  ],
  "build": [
    "cd libarchive-3.8.5 && ./configure --prefix=/usr --disable-static && make $MAKEOPTS"
  ],
  "install": [
    "cd libarchive-3.8.5 && DESTDIR=$DESTDIR make install",
    "ln -sfv bsdunzip $DESTDIR/usr/bin/unzip"
  ]
}
