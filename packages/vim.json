{
  "name": "vim",
  "description": "Vi Improved, a highly configurable text editor.",
  "version": "9.1",
  "dependencies": [],
  "download": [
    "git clone https://github.com/vim/vim.git"
  ],
  "build": [
    "cd vim && ./configure --prefix=$PREFIX",
    "cd vim && make $MAKEOPTS"
  ],
  "install": [
    "cd vim && make install"
  ]
}
