{
  "name": "libpsl",
  "description": "Library for accessing and resolving information from the Public Suffix List.",
  "version": "0.21.5",
  "dependencies": [
    "meson",
    "ninja"
  ],
  "download": [
    "curl -fL --retry 3 --retry-delay 2 -o libpsl-0.21.5.tar.gz https://github.com/rockdaboot/libpsl/releases/download/0.21.5/libpsl-0.21.5.tar.gz",
    "tar -xf libpsl-0.21.5.tar.gz"
  ],
  "build": [
    "meson setup --prefix=\"$PREFIX\" --buildtype=release libpsl-0.21.5/build libpsl-0.21.5",
    "ninja -C libpsl-0.21.5/build $MAKEOPTS"
  ],
  "install": [
    "DESTDIR=\"$DESTDIR\" ninja -C libpsl-0.21.5/build install"
  ]
}
